# Livello di log di make run-dev, al posto di quello di common/config/dev.py del job (DEBUG):
# LOG_LEVEL=INFO
# Per make plan e make deploy da locale, li scrive make cde-setup:
# CDE_VCLUSTER_ENDPOINT=https://<vcluster>.cloudera.site/dex/api/v1
# CDE_ACCESS_KEY_ID=<Access Key ID>
# CDE_ACCESS_KEY_SECRET=<Private Key>
# Facoltativo, l'URL da cui make cde-setup scarica la CLI cde se manca:
# CDE_CLI_DOWNLOAD_URL=https://<...>
